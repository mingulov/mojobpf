{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception",
  "license": "Apache-2.0 WITH LLVM-exception",
  "title": "MojoBPF capability registry",
  "description": "Structural contract for capabilities/registry.json: the frozen, deterministic inventory of upstream Linux eBPF capabilities. Every capability record carries upstream registration references, application predicates, implementation versus raw/typed API coverage, required target cells, tests/costs and its owning work package. A companion upstream lock file pins the exact upstream sources the registry was generated from. Case IDs name project harness cases; the same ID in positive_tests and negative_tests refers to that case's positive and negative variants. Unknown upstream atoms must fail generation until they are assigned an owner and tests; they must never be silently dropped.",
  "type": "object",
  "required": ["registry_version", "schema_version", "revision", "frozen", "generated_by", "packages", "families", "records", "enum_members", "blockers"],
  "additionalProperties": false,
  "properties": {
    "registry_version": {
      "description": "Registry interface version; this tooling reads capability-registry-v1 only.",
      "const": "capability-registry-v1"
    },
    "schema_version": {
      "description": "Registry schema version; this tooling reads version 1 only.",
      "const": 1
    },
    "revision": {
      "description": "Frozen inventory revision. Revision 1 is the first complete enumeration; later revisions only append upstream deltas without moving a release denominator.",
      "type": "integer"
    },
    "frozen": {
      "description": "True once the revision is sealed. A frozen registry is regenerated byte-identically from its pinned sources.",
      "const": true
    },
    "generated_by": {
      "description": "Provenance of this registry document.",
      "type": "object",
      "required": ["tool", "lock_digest"],
      "additionalProperties": false,
      "properties": {
        "tool": {
          "description": "Generator command that produced this document.",
          "type": "string"
        },
        "lock_digest": {
          "description": "SHA-256 of the upstream lock file this registry was generated from.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "packages": {
      "description": "Owning work packages. Every record owner_task must be one of these IDs.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "phase", "title"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9-]*$"
          },
          "phase": {
            "type": "string",
            "pattern": "^P[0-4]$"
          },
          "title": {
            "type": "string"
          }
        }
      }
    },
    "families": {
      "description": "Named upstream capability families. Each family resolves to records or to an explicit source-backed blocker.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "description", "owner_package", "harness_cases"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "owner_package": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9-]*$"
          },
          "harness_cases": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)+$"
            }
          }
        }
      }
    },
    "records": {
      "description": "Capability records, sorted by id.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "family", "owner_task", "scope_required", "upstream_source_refs", "kernel_registration_refs", "program_types", "attach_types", "link_types", "elf_sections", "map_types", "required_flags", "btf_requirements", "helpers_or_kfuncs", "callable_context_predicates", "compiler_surface", "userspace_api_surface", "implementation_state", "evidence_level", "applicability_predicate", "targets_required", "positive_tests", "negative_tests", "interaction_tests", "cost_cases", "blocker", "next_action", "evidence_refs"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z]+:[A-Za-z0-9_:+./-]+$"
          },
          "family": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "owner_task": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9-]*$"
          },
          "scope_required": {
            "const": true
          },
          "upstream_source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "kernel_registration_refs": {
            "description": "Kernel registration entries proving a helper/kfunc is callable in context, derived from the pinned kernel sources; BTF symbol presence alone never qualifies a call.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "program_types": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "attach_types": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "link_types": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "elf_sections": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "map_types": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "required_flags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "btf_requirements": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "helpers_or_kfuncs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "kind", "callable"],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "kind": {
                  "enum": ["helper", "kfunc"]
                },
                "callable": {
                  "description": "True only with a kernel registration reference proving the call is legal in context.",
                  "type": "boolean"
                }
              }
            }
          },
          "callable_context_predicates": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "needs_owner_review": {
            "description": "Non-empty when a governing registration filter uses constructs outside the understood filter grammar; the entry is callable:false by default-deny until an owner extends the grammar and tests. Fails completeness until resolved.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "compiler_surface": {
            "enum": ["program", "map-type", "helper-intrinsic", "flag-option", "instruction", "relocation", "btf-type", "section-convention", "raw-syscall", "library-symbol", "not-applicable"]
          },
          "userspace_api_surface": {
            "enum": ["load-attach", "map-ops", "event-consume", "section-convention", "raw-syscall", "library-symbol", "option-flag", "not-applicable"]
          },
          "implementation_state": {
            "enum": ["REPORTED", "AUDITED", "IN_PROGRESS", "IMPLEMENTED", "QUALIFIED", "BLOCKED_UPSTREAM", "BLOCKED_TOOLCHAIN", "BLOCKED_HARDWARE", "PLANNED"]
          },
          "evidence_level": {
            "enum": ["none", "reported", "audited", "tested"]
          },
          "applicability_predicate": {
            "type": "string"
          },
          "targets_required": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            }
          },
          "positive_tests": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)+$"
            }
          },
          "negative_tests": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)+$"
            }
          },
          "interaction_tests": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)+$"
            }
          },
          "cost_cases": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)+$"
            }
          },
          "blocker": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
              "status": {
                "enum": ["BLOCKED_UPSTREAM", "BLOCKED_TOOLCHAIN", "BLOCKED_HARDWARE", "PLANNED"]
              },
              "detail": {
                "type": "string"
              },
              "next_action": {
                "type": "string"
              }
            }
          },
          "next_action": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "enum_members": {
      "description": "Every upstream atom exactly once: enumerators, helper IDs, flags, limits, library symbols, section conventions and toolchain facts, each with its classification.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "container", "value", "value_text", "present_in", "classification", "record_id", "canonical", "record_refs", "note"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "container": {
            "type": "string"
          },
          "value": {
            "type": ["integer", "null"]
          },
          "value_text": {
            "type": ["string", "null"]
          },
          "present_in": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "classification": {
            "enum": ["capability", "alias", "sentinel", "context-only", "limit", "excluded"]
          },
          "record_id": {
            "type": ["string", "null"]
          },
          "canonical": {
            "type": ["string", "null"]
          },
          "record_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "blockers": {
      "description": "Family-level blockers for named families with no direct upstream record yet. Each cites its sources and next action.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "family", "status", "detail", "source_refs", "next_action"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "family": {
            "type": ["string", "null"]
          },
          "status": {
            "enum": ["BLOCKED_UPSTREAM", "BLOCKED_TOOLCHAIN", "BLOCKED_HARDWARE", "PLANNED"]
          },
          "detail": {
            "type": "string"
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "next_action": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "description": "Free-form revision notes. No release denominator or target claim may hide here.",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
