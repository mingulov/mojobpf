{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception",
  "license": "Apache-2.0 WITH LLVM-exception",
  "title": "MojoBPF test fixture ABI (test-contracts-v1)",
  "description": "Frozen fixture ABI: object identity, entry/program types, map layouts, event ABI, input corpus, oracle version and lifecycle barriers. Reuses standard ELF objects; this JSON contract carries test identity and provenance, not a loader format. Unknown fields are rejected.",
  "type": "object",
  "required": [
    "schema_version",
    "fixture_id",
    "object",
    "entries",
    "maps",
    "corpus",
    "oracle",
    "barriers"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "description": "Fixture schema version; test-contracts-v1 reads version 1 only.",
      "const": 1
    },
    "fixture_id": {
      "description": "Stable fixture identifier; referenced by run plans and results.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "object": {
      "type": "object",
      "required": ["path", "sha256", "bytes"],
      "additionalProperties": false,
      "properties": {
        "path": {
          "description": "Object path relative to the fixture root.",
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "description": "SHA-256 of the exact object bytes consumed by the run.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "description": "Object size in bytes.",
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "entries": {
      "description": "Entry points exercised by this fixture; at least one.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["symbol", "program_type", "section"],
        "additionalProperties": false,
        "properties": {
          "symbol": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "program_type": {
            "type": "string",
            "minLength": 1
          },
          "section": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "maps": {
      "description": "Map layouts used by this fixture; empty when the fixture uses no maps.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "map_type", "key", "value", "max_entries"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "map_type": {
            "type": "string",
            "minLength": 1
          },
          "key": {
            "type": "object",
            "required": ["type", "bytes"],
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1
              },
              "bytes": {
                "description": "Key size in bytes; 0 for keyless layouts such as ring buffers.",
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "value": {
            "type": "object",
            "required": ["type", "bytes"],
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1
              },
              "bytes": {
                "description": "Value size in bytes; 0 for valueless layouts such as ring buffers.",
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "max_entries": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          }
        }
      }
    },
    "event_abi": {
      "description": "Event record ABI; null when the fixture produces no events.",
      "type": ["object", "null"],
      "required": ["version", "record_bytes"],
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "record_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "framing": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "corpus": {
      "description": "Input corpus identity shared by producers and consumers.",
      "type": "object",
      "required": ["corpus_id", "sha256", "record_count"],
      "additionalProperties": false,
      "properties": {
        "corpus_id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "record_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "oracle": {
      "description": "Independent oracle name and pinned version.",
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "barriers": {
      "description": "Lifecycle barriers the workload honors; at least one.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["ready", "start", "stop", "drained"]
      }
    }
  }
}
