{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception",
  "license": "Apache-2.0 WITH LLVM-exception",
  "title": "MojoBPF capability coverage ledger",
  "description": "Materialized join of the capability registry, the target matrix, and the independently packaged library API coverage artifact. Each cell is one record x target x path evaluated to a coverage status: QUALIFIED only for implemented, tested, evidence-bound work whose consumer verdict (when applicable) passes; OPEN for outstanding work including blocked targets; NOT_APPLICABLE only for justified exclusions.",
  "type": "object",
  "required": ["ledger_version", "inputs", "blockers", "cells"],
  "additionalProperties": false,
  "properties": {
    "ledger_version": {
      "type": "integer",
      "const": 1
    },
    "inputs": {
      "type": "object",
      "required": ["registry_sha256", "matrix_sha256", "api_coverage_sha256", "api_provenance", "api_artifact_sha256", "record_count", "cell_count"],
      "additionalProperties": false,
      "properties": {
        "registry_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "maxLength": 64
        },
        "matrix_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "maxLength": 64
        },
        "api_coverage_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "maxLength": 64
        },
        "api_provenance": {
          "type": "object",
          "required": ["repo", "rev", "path"],
          "additionalProperties": false,
          "properties": {
            "repo": {
              "type": "string",
              "minLength": 1
            },
            "rev": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$",
              "maxLength": 40
            },
            "path": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "api_artifact_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "maxLength": 64
        },
        "record_count": {
          "type": "integer",
          "minimum": 1
        },
        "cell_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "blockers": {
      "description": "Registry top-level blockers carried through with the count of cells each one matches, so an unmatched blocker stays visible instead of failing or vanishing.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "family", "status", "matched_cells"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "family": {
            "type": ["string", "null"]
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "matched_cells": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "cells": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "record", "target", "path", "status", "implementation", "qualification", "obligations", "applicability", "legal_context", "producer"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(?![\\s\\S]*[\\r\\n\\u0085\\u2028\\u2029])[^@#]+@[^@#]+#(producer|consumer)$"
          },
          "record": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "enum": ["producer", "consumer"]
          },
          "status": {
            "type": "string",
            "enum": ["QUALIFIED", "OPEN", "NOT_APPLICABLE"]
          },
          "rationale": {
            "type": "object",
            "required": ["status", "detail"],
            "additionalProperties": false,
            "properties": {
              "status": {
                "type": "string",
                "minLength": 1
              },
              "detail": {
                "type": "string",
                "minLength": 1
              },
              "next_action": {
                "type": "string"
              },
              "source_refs": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1, "pattern": "\\S"}
              }
            }
          },
          "implementation": {
            "type": "object",
            "required": ["package_title", "state", "evidence_level"],
            "additionalProperties": false,
            "properties": {
              "package_title": {
                "description": "Human-readable owning-package title; join titles to the registry packages list for package IDs.",
                "type": "string",
                "minLength": 1
              },
              "state": {
                "type": "string",
                "minLength": 1
              },
              "evidence_level": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "qualification": {
            "description": "Qualification-leaf join keys: the specific test case IDs whose results qualify this cell.",
            "type": "object",
            "required": ["positive_tests", "negative_tests", "interaction_tests"],
            "additionalProperties": false,
            "properties": {
              "positive_tests": {
                "type": "array",
                "items": {"type": "string"}
              },
              "negative_tests": {
                "type": "array",
                "items": {"type": "string"}
              },
              "interaction_tests": {
                "type": "array",
                "items": {"type": "string"}
              }
            }
          },
          "obligations": {
            "type": "object",
            "required": ["lifecycle"],
            "additionalProperties": false,
            "properties": {
              "lifecycle": {
                "type": "array",
                "items": {"type": "string"}
              },
              "cost_cases": {
                "type": "array",
                "items": {"type": "string", "minLength": 1, "pattern": "\\S"}
              }
            }
          },
          "applicability": {
            "type": "object",
            "required": ["predicate", "evidence_refs", "upstream_refs"],
            "additionalProperties": false,
            "properties": {
              "predicate": {
                "type": "string"
              },
              "evidence_refs": {
                "type": "array",
                "items": {"type": "string", "minLength": 1, "pattern": "\\S"}
              },
              "upstream_refs": {
                "type": "array",
                "items": {"type": "string", "minLength": 1, "pattern": "\\S"}
              }
            }
          },
          "legal_context": {
            "description": "Legal program/attach/context binding: the program types, attach/link variants, map types, helpers, and context predicates this cell's operation is valid under.",
            "type": "object",
            "required": ["program_types", "attach_types", "link_types", "map_types", "helpers_or_kfuncs", "callable_context_predicates"],
            "additionalProperties": false,
            "properties": {
              "program_types": {
                "type": "array",
                "items": {"type": "string"}
              },
              "attach_types": {
                "type": "array",
                "items": {"type": "string"}
              },
              "link_types": {
                "type": "array",
                "items": {"type": "string"}
              },
              "map_types": {
                "type": "array",
                "items": {"type": "string"}
              },
              "helpers_or_kfuncs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name", "kind", "callable"],
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "kind": {
                      "enum": ["helper", "kfunc"]
                    },
                    "callable": {
                      "type": "boolean"
                    }
                  }
                }
              },
              "callable_context_predicates": {
                "type": "array",
                "items": {"type": "string"}
              }
            }
          },
          "producer": {
            "type": "object",
            "required": ["scope_required", "family"],
            "additionalProperties": false,
            "properties": {
              "scope_required": {
                "const": true
              },
              "family": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "consumer": {
            "type": "object",
            "required": ["api_row", "verdict"],
            "additionalProperties": false,
            "properties": {
              "api_row": {
                "type": "string",
                "minLength": 1
              },
              "verdict": {
                "type": "object",
                "required": ["applicability", "blocker", "raw_status", "forwarding_status", "typed_status", "layers"],
                "additionalProperties": false,
                "properties": {
                  "applicability": {
                    "type": "string",
                    "minLength": 1
                  },
                  "blocker": {
                    "type": ["object", "null"],
                    "required": ["reason", "next_action"],
                    "properties": {
                      "reason": {
                        "type": "string"
                      },
                      "next_action": {
                        "type": "string"
                      }
                    }
                  },
                  "raw_status": {
                    "type": "string",
                    "minLength": 1
                  },
                  "forwarding_status": {
                    "type": "string",
                    "minLength": 1
                  },
                  "typed_status": {
                    "type": "string",
                    "minLength": 1
                  },
                  "layers": {
                    "type": "array",
                    "maxItems": 6,
                    "items": {
                      "type": "object",
                      "required": ["layer", "outcome", "target_profile"],
                      "additionalProperties": false,
                      "properties": {
                        "layer": {
                          "type": "string",
                          "minLength": 1
                        },
                        "outcome": {
                          "type": "string",
                          "enum": ["NOT_RUN", "PASS", "FAIL", "BLOCKED"]
                        },
                        "target_profile": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {"properties": {"status": {"const": "QUALIFIED"}}},
            "then": {
              "not": {"required": ["rationale"]},
              "properties": {
                "implementation": {
                  "properties": {
                    "state": {"enum": ["IMPLEMENTED", "QUALIFIED"]},
                    "evidence_level": {"const": "tested"}
                  }
                },
                "applicability": {
                  "properties": {
                    "evidence_refs": {"minItems": 1}
                  }
                }
              }
            }
          },
          {
            "if": {"properties": {"path": {"const": "consumer"}}},
            "then": {"required": ["consumer"]}
          },
          {
            "if": {"properties": {"status": {"const": "NOT_APPLICABLE"}}},
            "then": {
              "required": ["rationale"],
              "properties": {
                "rationale": {
                  "required": ["source_refs"],
                  "properties": {
                    "status": {"const": "NOT_APPLICABLE"}
                  }
                }
              }
            }
          },
          {
            "if": {
              "allOf": [
                {"properties": {"status": {"const": "QUALIFIED"}}},
                {"properties": {"path": {"const": "consumer"}}}
              ]
            },
            "then": {
              "properties": {
                "consumer": {
                  "properties": {
                    "verdict": {
                      "properties": {
                        "applicability": {"const": "required"},
                        "blocker": {"type": "null"},
                        "raw_status": {
                          "enum": ["SOURCE_PRESENT", "NOT_APPLICABLE"]
                        },
                        "forwarding_status": {
                          "enum": [
                            "SOURCE_PRESENT_PARTIAL",
                            "SOURCE_PRESENT_COMPLETE",
                            "NOT_APPLICABLE"
                          ]
                        },
                        "typed_status": {
                          "enum": [
                            "SOURCE_PRESENT_PARTIAL",
                            "SOURCE_PRESENT_COMPLETE",
                            "NOT_APPLICABLE"
                          ]
                        },
                        "layers": {
                          "maxItems": 6,
                          "allOf": [
                            {
                              "contains": {
                                "properties": {
                                  "layer": {"const": "source"}
                                }
                              }
                            },
                            {
                              "contains": {
                                "properties": {
                                  "layer": {"const": "native_host"}
                                }
                              }
                            },
                            {
                              "contains": {
                                "properties": {
                                  "layer": {"const": "mojo_host"}
                                }
                              }
                            },
                            {
                              "contains": {
                                "properties": {
                                  "layer": {"const": "installed_host"}
                                }
                              }
                            },
                            {
                              "contains": {
                                "properties": {
                                  "layer": {"const": "target_runtime"}
                                }
                              }
                            },
                            {
                              "contains": {
                                "properties": {
                                  "layer": {"const": "binary_abi"}
                                }
                              }
                            }
                          ],
                          "items": {
                            "properties": {
                              "outcome": {"const": "PASS"}
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
