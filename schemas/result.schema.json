{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception",
  "license": "Apache-2.0 WITH LLVM-exception",
  "title": "MojoBPF case result and suite result (test-contracts-v1, suite-result-v1)",
  "description": "CaseResult carries run/case/attempt IDs, plan hash, repository/package/tool/consumer/object/target identities, applicability, expected/observed values, failure stage, outcome, evidence digests, cleanup and costs. SuiteResult is the terminal record binding every expected case and attempt. Unknown fields are rejected everywhere.",
  "$defs": {
    "execution_outcome": {
      "enum": ["PASS", "FAIL", "INFRA_ERROR", "NOT_RUN"]
    },
    "availability": {
      "enum": ["APPLICABLE", "KERNEL_FEATURE_ABSENT", "CONFIG_DISABLED", "POLICY_DENIED", "TARGET_RESOURCE_ABSENT", "HARDWARE_MISSING", "TOOLCHAIN_UNAVAILABLE", "UPSTREAM_BLOCKED", "NOT_APPLICABLE", "UNKNOWN"]
    },
    "failure_stage": {
      "enum": ["BUILD", "ARTIFACT_INSPECTION", "LOAD", "ATTACH", "TEST_RUN", "RUNTIME", "VERIFY", "CLEANUP", "COST", "INFRA"]
    },
    "behavior": {
      "type": "object",
      "required": ["outcome", "failure_stage"],
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "$ref": "#/$defs/execution_outcome"
        },
        "failure_stage": {
          "description": "Failure stage; null exactly when outcome is PASS.",
          "type": ["string", "null"],
          "enum": ["BUILD", "ARTIFACT_INSPECTION", "LOAD", "ATTACH", "TEST_RUN", "RUNTIME", "VERIFY", "CLEANUP", "COST", "INFRA", null]
        },
        "value": {
          "description": "Optional semantic payload observed for this behavior (for example the map value 42 in the 41→42 oracle). Any JSON value; compared exactly with strict JSON types, so boolean true never equals number 1 at any nesting depth."
        },
        "error_class": {
          "description": "Optional structured semantic error class for failures; kernel wording varies, so only the class is asserted.",
          "type": "string",
          "minLength": 1
        }
      },
      "if": {
        "properties": {
          "outcome": {
            "const": "PASS"
          }
        },
        "required": ["outcome"]
      },
      "then": {
        "properties": {
          "failure_stage": {
            "const": null
          }
        }
      },
      "else": {
        "properties": {
          "failure_stage": {
            "$ref": "#/$defs/failure_stage"
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["path", "sha256", "bytes"],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "case_result": {
      "type": "object",
      "required": [
        "schema_version",
        "run_id",
        "case_id",
        "target_fingerprint",
        "attempt",
        "plan_hash",
        "identities",
        "applicability",
        "required",
        "expected",
        "observed",
        "outcome",
        "failure_stage",
        "evidence",
        "cleanup"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "description": "A PASS carries evidence, clean cleanup, a null stage, a PASS expectation and a PASS observation.",
          "$comment": "Parity boundary: this rule pins PASS outcome/failure_stage shape only. Full expected/observed equality over value/error_class is inexpressible here (no cross-property comparison for arbitrary JSON) and is enforced by the Python parser with strict JSON types (MBPF305).",
          "if": {
            "properties": {
              "outcome": {
                "const": "PASS"
              }
            },
            "required": ["outcome"]
          },
          "then": {
            "properties": {
              "failure_stage": {
                "const": null
              },
              "evidence": {
                "minItems": 1
              },
              "cleanup": {
                "properties": {
                  "status": {
                    "const": "CLEAN"
                  }
                },
                "required": ["status"]
              },
              "expected": {
                "properties": {
                  "outcome": {
                    "const": "PASS"
                  },
                  "failure_stage": {
                    "const": null
                  }
                }
              },
              "observed": {
                "properties": {
                  "outcome": {
                    "const": "PASS"
                  },
                  "failure_stage": {
                    "const": null
                  }
                }
              }
            }
          }
        },
        {
          "description": "The top-level outcome repeats the observed outcome.",
          "if": {"properties": {"outcome": {"const": "PASS"}}, "required": ["outcome"]},
          "then": {"properties": {"observed": {"properties": {"outcome": {"const": "PASS"}}}}}
        },
        {
          "if": {"properties": {"outcome": {"const": "FAIL"}}, "required": ["outcome"]},
          "then": {"properties": {"observed": {"properties": {"outcome": {"const": "FAIL"}}}}}
        },
        {
          "if": {"properties": {"outcome": {"const": "INFRA_ERROR"}}, "required": ["outcome"]},
          "then": {"properties": {"observed": {"properties": {"outcome": {"const": "INFRA_ERROR"}}}}}
        },
        {
          "if": {"properties": {"outcome": {"const": "NOT_RUN"}}, "required": ["outcome"]},
          "then": {"properties": {"observed": {"properties": {"outcome": {"const": "NOT_RUN"}}}}}
        },
        {
          "description": "The top-level failure stage repeats the observed stage.",
          "if": {"properties": {"failure_stage": {"type": "null"}}, "required": ["failure_stage"]},
          "then": {"properties": {"observed": {"properties": {"failure_stage": {"type": "null"}}}}}
        },
        {
          "if": {"properties": {"failure_stage": {"const": "BUILD"}}},
          "then": {"properties": {"observed": {"properties": {"failure_stage": {"const": "BUILD"}}}}}
        },
        {
          "if": {"properties": {"failure_stage": {"const": "ARTIFACT_INSPECTION"}}},
          "then": {"properties": {"observed": {"properties": {"failure_stage": {"const": "ARTIFACT_INSPECTION"}}}}}
        },
        {
          "if": {"properties": {"failure_stage": {"const": "LOAD"}}},
          "then": {"properties": {"observed": {"properties": {"failure_stage": {"const": "LOAD"}}}}}
        },
        {
          "if": {"properties": {"failure_stage": {"const": "ATTACH"}}},
          "then": {"properties": {"observed": {"properties": {"failure_stage": {"const": "ATTACH"}}}}}
        },
        {
          "if": {"properties": {"failure_stage": {"const": "TEST_RUN"}}},
          "then": {"properties": {"observed": {"properties": {"failure_stage": {"const": "TEST_RUN"}}}}}
        },
        {
          "if": {"properties": {"failure_stage": {"const": "RUNTIME"}}},
          "then": {"properties": {"observed": {"properties": {"failure_stage": {"const": "RUNTIME"}}}}}
        },
        {
          "if": {"properties": {"failure_stage": {"const": "VERIFY"}}},
          "then": {"properties": {"observed": {"properties": {"failure_stage": {"const": "VERIFY"}}}}}
        },
        {
          "if": {"properties": {"failure_stage": {"const": "CLEANUP"}}},
          "then": {"properties": {"observed": {"properties": {"failure_stage": {"const": "CLEANUP"}}}}}
        },
        {
          "if": {"properties": {"failure_stage": {"const": "COST"}}},
          "then": {"properties": {"observed": {"properties": {"failure_stage": {"const": "COST"}}}}}
        },
        {
          "if": {"properties": {"failure_stage": {"const": "INFRA"}}},
          "then": {"properties": {"observed": {"properties": {"failure_stage": {"const": "INFRA"}}}}}
        },
        {
          "description": "Exclusion from the gate denominator needs proof.",
          "if": {
            "properties": {
              "applicability": {
                "const": "NOT_APPLICABLE"
              }
            },
            "required": ["applicability"]
          },
          "then": {
            "properties": {
              "evidence": {
                "minItems": 1
              }
            }
          }
        }
      ],
      "properties": {
        "schema_version": {
          "description": "Result schema version; test-contracts-v1 reads version 1 only.",
          "const": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "case_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "target_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "attempt": {
          "description": "One-based attempt number; attempts per cell are contiguous from 1.",
          "type": "integer",
          "minimum": 1
        },
        "plan_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "identities": {
          "type": "object",
          "required": ["repository_commit", "package", "tool", "consumer", "object_sha256", "source_sha256", "workload"],
          "additionalProperties": false,
          "properties": {
            "repository_commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "package": {
              "type": "string",
              "minLength": 1
            },
            "tool": {
              "type": "string",
              "minLength": 1
            },
            "consumer": {
              "type": "object",
              "required": ["name", "version", "artifact_sha256"],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                },
                "artifact_sha256": {
                  "description": "SHA-256 of the exact consumer artifact that produced the result.",
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            "object_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "source_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "workload": {
              "description": "Workload identity; a result without one is missing its workload.",
              "type": "object",
              "required": ["fixture_id", "corpus_sha256"],
              "additionalProperties": false,
              "properties": {
                "fixture_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                },
                "corpus_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        },
        "applicability": {
          "$ref": "#/$defs/availability"
        },
        "required": {
          "type": "boolean"
        },
        "expected": {
          "$ref": "#/$defs/behavior"
        },
        "observed": {
          "$ref": "#/$defs/behavior"
        },
        "outcome": {
          "$ref": "#/$defs/execution_outcome"
        },
        "failure_stage": {
          "description": "Top-level failure stage; null exactly when outcome is PASS.",
          "type": ["string", "null"],
          "enum": ["BUILD", "ARTIFACT_INSPECTION", "LOAD", "ATTACH", "TEST_RUN", "RUNTIME", "VERIFY", "CLEANUP", "COST", "INFRA", null]
        },
        "evidence": {
          "description": "Raw evidence sufficient to check the verdict; non-empty for PASS.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "cleanup": {
          "type": "object",
          "required": ["status", "residue"],
          "additionalProperties": false,
          "allOf": [
            {
              "description": "CLEAN cleanup carries no residue entries.",
              "if": {
                "properties": {
                  "status": {
                    "const": "CLEAN"
                  }
                },
                "required": ["status"]
              },
              "then": {
                "properties": {
                  "residue": {
                    "maxItems": 0
                  }
                }
              }
            },
            {
              "description": "RESIDUE cleanup names its residue.",
              "if": {
                "properties": {
                  "status": {
                    "const": "RESIDUE"
                  }
                },
                "required": ["status"]
              },
              "then": {
                "properties": {
                  "residue": {
                    "minItems": 1
                  }
                }
              }
            }
          ],
          "properties": {
            "status": {
              "enum": ["CLEAN", "RESIDUE", "NOT_CHECKED"]
            },
            "residue": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "costs": {
          "description": "Cost records attached to this result; may be empty while budgets are pending. Each entry is a full cost record.",
          "type": "array",
          "default": [],
          "items": {
            "description": "One measured cost attached to a case result. Metric values are numeric or explicitly unavailable with a reason, never a fabricated zero. Numeric budgets live in a separate size-budget record owned by later cost work; this schema carries measurements only. Unknown fields are rejected.",
            "type": "object",
            "required": [
              "schema_version",
              "case_id",
              "target_fingerprint",
              "metric",
              "unit",
              "value",
              "basis"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "value": {
                      "type": "null"
                    }
                  },
                  "required": [
                    "value"
                  ]
                },
                "then": {
                  "properties": {
                    "unavailable_reason": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "unavailable_reason"
                  ]
                },
                "else": {
                  "properties": {
                    "unavailable_reason": {
                      "enum": [
                        null
                      ]
                    }
                  }
                }
              }
            ],
            "properties": {
              "schema_version": {
                "description": "Cost schema version; test-contracts-v1 reads version 1 only.",
                "const": 1
              },
              "case_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
              },
              "target_fingerprint": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "metric": {
                "description": "Metric name (for example reachable_slots, executable_bytes, jit_bytes).",
                "type": "string",
                "minLength": 1
              },
              "unit": {
                "description": "Unit name (for example slots, bytes, microseconds).",
                "type": "string",
                "minLength": 1
              },
              "value": {
                "description": "Measured value; null exactly when unavailable_reason explains the absence.",
                "type": [
                  "number",
                  "null"
                ]
              },
              "unavailable_reason": {
                "description": "Required exactly when value is null.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "basis": {
                "description": "Measurement conditions pinning the number to one artifact and profile.",
                "type": "object",
                "required": [
                  "object_sha256",
                  "profile"
                ],
                "additionalProperties": false,
                "properties": {
                  "object_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "profile": {
                    "type": "string",
                    "minLength": 1
                  },
                  "flags": {
                    "type": "array",
                    "default": [],
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "coverage_ledger": {
      "type": "object",
      "required": ["required", "applicable", "executed", "passed", "failed", "blocked", "not_run"],
      "additionalProperties": false,
      "properties": {
        "required": {
          "$ref": "#/$defs/cell_list"
        },
        "applicable": {
          "$ref": "#/$defs/cell_list"
        },
        "executed": {
          "$ref": "#/$defs/cell_list"
        },
        "passed": {
          "$ref": "#/$defs/cell_list"
        },
        "failed": {
          "$ref": "#/$defs/cell_list"
        },
        "blocked": {
          "$ref": "#/$defs/cell_list"
        },
        "not_run": {
          "$ref": "#/$defs/cell_list"
        }
      }
    },
    "cell_list": {
      "type": "object",
      "required": ["count", "cells"],
      "additionalProperties": false,
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "cells": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "gate_decision": {
      "type": "object",
      "required": ["verdict", "reasons"],
      "additionalProperties": false,
      "properties": {
        "verdict": {
          "enum": ["PASS", "FAIL", "INCOMPLETE"]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "suite_result": {
      "type": "object",
      "required": [
        "schema_version",
        "suite_result_version",
        "run_id",
        "plan_hash",
        "result_digests",
        "rejected_digests",
        "attempts_preserved",
        "ledger",
        "decision"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "suite_result_version": {
          "const": "suite-result-v1"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "plan_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "result_digests": {
          "description": "SHA-256 of the canonical JSON of every accepted CaseResult, in submission order.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "rejected_digests": {
          "description": "SHA-256 binding every rejected attempt (raw record digest, or the deterministic rejection entry when the record has no canonical form), in rejection order.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "attempts_preserved": {
          "description": "Total attempts preserved, including rejected ones.",
          "type": "integer",
          "minimum": 0
        },
        "ledger": {
          "$ref": "#/$defs/coverage_ledger"
        },
        "decision": {
          "$ref": "#/$defs/gate_decision"
        }
      }
    }
  },
  "title": "MojoBPF case result (test-contracts-v1)",
  "description": "This document validates one CaseResult; SuiteResult is defined under $defs/suite_result. Parity boundary: this schema pins the PASS outcome/failure_stage/evidence/cleanup shape but cannot express full expected/observed equality for arbitrary JSON values (JSON Schema has no cross-property comparison); the Python parser enforces that equality with strict JSON types, where boolean true never equals number 1, and rejects mismatches with MBPF305.",
  "$ref": "#/$defs/case_result"
}
