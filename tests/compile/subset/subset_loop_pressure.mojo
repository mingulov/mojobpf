# case: loop-pressure
# Runtime-bounded loop with 40 carried u64 accumulators (~280B frame, within budget).
from mojobpf.packet import GUARD_ACTION, XDP_DROP, XDP_PASS, XdpCtx, load_u8, packet_addr, packet_base, packet_len, packet_short


@export
def xdp_entry(ctx: MutPointer[UInt8, MutAnyOrigin]) abi("C") -> Int32:
    var pkt = XdpCtx.from_ctx(ctx)
    if packet_short(pkt, 54):
        return Int32(GUARD_ACTION)
    var base = packet_base(packet_addr(pkt, 0))
    var a0 = UInt64(load_u8(base, 14)) + UInt64(0)
    var a1 = UInt64(load_u8(base, 15)) + UInt64(1)
    var a2 = UInt64(load_u8(base, 16)) + UInt64(2)
    var a3 = UInt64(load_u8(base, 17)) + UInt64(3)
    var a4 = UInt64(load_u8(base, 18)) + UInt64(4)
    var a5 = UInt64(load_u8(base, 19)) + UInt64(5)
    var a6 = UInt64(load_u8(base, 20)) + UInt64(6)
    var a7 = UInt64(load_u8(base, 21)) + UInt64(7)
    var a8 = UInt64(load_u8(base, 22)) + UInt64(8)
    var a9 = UInt64(load_u8(base, 23)) + UInt64(9)
    var a10 = UInt64(load_u8(base, 24)) + UInt64(10)
    var a11 = UInt64(load_u8(base, 25)) + UInt64(11)
    var a12 = UInt64(load_u8(base, 26)) + UInt64(12)
    var a13 = UInt64(load_u8(base, 27)) + UInt64(13)
    var a14 = UInt64(load_u8(base, 28)) + UInt64(14)
    var a15 = UInt64(load_u8(base, 29)) + UInt64(15)
    var a16 = UInt64(load_u8(base, 30)) + UInt64(16)
    var a17 = UInt64(load_u8(base, 31)) + UInt64(17)
    var a18 = UInt64(load_u8(base, 32)) + UInt64(18)
    var a19 = UInt64(load_u8(base, 33)) + UInt64(19)
    var a20 = UInt64(load_u8(base, 34)) + UInt64(20)
    var a21 = UInt64(load_u8(base, 35)) + UInt64(21)
    var a22 = UInt64(load_u8(base, 36)) + UInt64(22)
    var a23 = UInt64(load_u8(base, 37)) + UInt64(23)
    var a24 = UInt64(load_u8(base, 38)) + UInt64(24)
    var a25 = UInt64(load_u8(base, 39)) + UInt64(25)
    var a26 = UInt64(load_u8(base, 40)) + UInt64(26)
    var a27 = UInt64(load_u8(base, 41)) + UInt64(27)
    var a28 = UInt64(load_u8(base, 42)) + UInt64(28)
    var a29 = UInt64(load_u8(base, 43)) + UInt64(29)
    var a30 = UInt64(load_u8(base, 44)) + UInt64(30)
    var a31 = UInt64(load_u8(base, 45)) + UInt64(31)
    var a32 = UInt64(load_u8(base, 46)) + UInt64(32)
    var a33 = UInt64(load_u8(base, 47)) + UInt64(33)
    var a34 = UInt64(load_u8(base, 48)) + UInt64(34)
    var a35 = UInt64(load_u8(base, 49)) + UInt64(35)
    var a36 = UInt64(load_u8(base, 50)) + UInt64(36)
    var a37 = UInt64(load_u8(base, 51)) + UInt64(37)
    var a38 = UInt64(load_u8(base, 52)) + UInt64(38)
    var a39 = UInt64(load_u8(base, 53)) + UInt64(39)
    var n = Int(packet_len(pkt) & UInt64(7)) + 1
    var i = 0
    while i < n:
        a0 ^= (a0 >> UInt64(13)) + UInt64(i) + UInt64(1)
        a1 ^= (a1 >> UInt64(13)) + UInt64(i) + UInt64(8)
        a2 ^= (a2 >> UInt64(13)) + UInt64(i) + UInt64(15)
        a3 ^= (a3 >> UInt64(13)) + UInt64(i) + UInt64(22)
        a4 ^= (a4 >> UInt64(13)) + UInt64(i) + UInt64(29)
        a5 ^= (a5 >> UInt64(13)) + UInt64(i) + UInt64(36)
        a6 ^= (a6 >> UInt64(13)) + UInt64(i) + UInt64(43)
        a7 ^= (a7 >> UInt64(13)) + UInt64(i) + UInt64(50)
        a8 ^= (a8 >> UInt64(13)) + UInt64(i) + UInt64(57)
        a9 ^= (a9 >> UInt64(13)) + UInt64(i) + UInt64(64)
        a10 ^= (a10 >> UInt64(13)) + UInt64(i) + UInt64(71)
        a11 ^= (a11 >> UInt64(13)) + UInt64(i) + UInt64(78)
        a12 ^= (a12 >> UInt64(13)) + UInt64(i) + UInt64(85)
        a13 ^= (a13 >> UInt64(13)) + UInt64(i) + UInt64(92)
        a14 ^= (a14 >> UInt64(13)) + UInt64(i) + UInt64(99)
        a15 ^= (a15 >> UInt64(13)) + UInt64(i) + UInt64(106)
        a16 ^= (a16 >> UInt64(13)) + UInt64(i) + UInt64(113)
        a17 ^= (a17 >> UInt64(13)) + UInt64(i) + UInt64(120)
        a18 ^= (a18 >> UInt64(13)) + UInt64(i) + UInt64(127)
        a19 ^= (a19 >> UInt64(13)) + UInt64(i) + UInt64(134)
        a20 ^= (a20 >> UInt64(13)) + UInt64(i) + UInt64(141)
        a21 ^= (a21 >> UInt64(13)) + UInt64(i) + UInt64(148)
        a22 ^= (a22 >> UInt64(13)) + UInt64(i) + UInt64(155)
        a23 ^= (a23 >> UInt64(13)) + UInt64(i) + UInt64(162)
        a24 ^= (a24 >> UInt64(13)) + UInt64(i) + UInt64(169)
        a25 ^= (a25 >> UInt64(13)) + UInt64(i) + UInt64(176)
        a26 ^= (a26 >> UInt64(13)) + UInt64(i) + UInt64(183)
        a27 ^= (a27 >> UInt64(13)) + UInt64(i) + UInt64(190)
        a28 ^= (a28 >> UInt64(13)) + UInt64(i) + UInt64(197)
        a29 ^= (a29 >> UInt64(13)) + UInt64(i) + UInt64(204)
        a30 ^= (a30 >> UInt64(13)) + UInt64(i) + UInt64(211)
        a31 ^= (a31 >> UInt64(13)) + UInt64(i) + UInt64(218)
        a32 ^= (a32 >> UInt64(13)) + UInt64(i) + UInt64(225)
        a33 ^= (a33 >> UInt64(13)) + UInt64(i) + UInt64(232)
        a34 ^= (a34 >> UInt64(13)) + UInt64(i) + UInt64(239)
        a35 ^= (a35 >> UInt64(13)) + UInt64(i) + UInt64(246)
        a36 ^= (a36 >> UInt64(13)) + UInt64(i) + UInt64(253)
        a37 ^= (a37 >> UInt64(13)) + UInt64(i) + UInt64(260)
        a38 ^= (a38 >> UInt64(13)) + UInt64(i) + UInt64(267)
        a39 ^= (a39 >> UInt64(13)) + UInt64(i) + UInt64(274)
        i += 1
    var total = a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + a9 + a10 + a11 + a12 + a13 + a14 + a15 + a16 + a17 + a18 + a19 + a20 + a21 + a22 + a23 + a24 + a25 + a26 + a27 + a28 + a29 + a30 + a31 + a32 + a33 + a34 + a35 + a36 + a37 + a38 + a39
    if total & UInt64(1) == UInt64(1):
        return Int32(XDP_DROP)
    return Int32(XDP_PASS)
